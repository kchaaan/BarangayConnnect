# PHP server process environment only. Do not expose in HTML/JS or commit real values.
# MySQL stores legacy business data. On Clever Cloud, leave BC_DB_* unset so
# the linked add-on's MYSQL_ADDON_* variables are used automatically. On cPanel,
# uncomment these and set the values provided by the hosting provider.
# BC_DB_HOST=localhost
# BC_DB_PORT=3306
# BC_DB_USER=your_database_user
# BC_DB_PASS=your_database_password
# BC_DB_NAME=your_database_name

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
TURNSTILE_SITE_KEY=your-public-turnstile-site-key
TURNSTILE_SECRET_KEY=server-only-turnstile-secret
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Set to 1 only after enabling Supabase phone auth and configuring an SMS provider.
BC_SUPABASE_SMS_OTP_ENABLED=0
# On localhost, CAPTCHA uses a loopback-only test token automatically.
# On production hosts, configure real Turnstile keys and never enable a bypass.
